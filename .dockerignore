# Python cache
__pycache__/
*.py[cod]

# Virtual environment
venv/
.venv/

# Environment variables (never copy .env into the image)
.env
.env.*

# Frontend (built in Docker stage 1)
node_modules/

# Local DB and user uploads (mounted as volumes in production)
db.sqlite3
media/
logs/

# IDE / git
.idea/
.git/
.gitignore

# Compose files are not needed inside the image
docker-compose*.yml
