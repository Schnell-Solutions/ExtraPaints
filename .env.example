# =============================================================================
# Local development (manage.py runserver)
# =============================================================================
DEBUG=1
SECRET_KEY=change-me-for-local-only
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DATABASE_URL=sqlite:///db.sqlite3

# Tailwind: 1 = CDN (fast local dev). 0 = compiled CSS (`npm run build:css`).
TAILWIND_CDN=1

# Optional local Redis cache
# CACHE_URL=redis://127.0.0.1:6379/1

# =============================================================================
# Docker Compose (copy to .env and adjust before: docker compose up -d --build)
# =============================================================================
# DEBUG=0
# SECRET_KEY=generate-a-long-random-secret
# ALLOWED_HOSTS=extrapaints.co.ke,www.extrapaints.co.ke
# CSRF_TRUSTED_ORIGINS=https://extrapaints.co.ke,https://www.extrapaints.co.ke
#
# Postgres (used by docker-compose db + web services)
# POSTGRES_DB=extrapaints
# POSTGRES_USER=extrapaints
# POSTGRES_PASSWORD=change-me-strong-password
#
# Behind nginx: proxy TLS + secure cookies; nginx handles HTTP→HTTPS redirect
# USE_SECURE_PROXY=1
# SECURE_SSL_REDIRECT=0
# SECURE_HSTS_SECONDS=31536000
#
# PUBLIC_SITE_URL=https://www.extrapaints.co.ke
# TAILWIND_CDN=0
# STATIC_VERSION=1
# LOG_LEVEL=INFO
# GUNICORN_WORKERS=3
# GUNICORN_TIMEOUT=120
#
# EMAIL_HOST=mail.yourprovider.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=noreply@extrapaints.co.ke
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=ExtraPaints <noreply@extrapaints.co.ke>
# SALES_TEAM_EMAIL=sales@extrapaints.co.ke
# ADMIN_EMAIL=ops@example.com
#
# BUSINESS_WHATSAPP=254750422863
# BUSINESS_PHONE_PRIMARY=+254729086036
# COMPANY_FOUNDED_YEAR=2015
# REFERRAL_COOKIE_MAX_AGE=5184000
