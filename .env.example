# Local development only (manage.py runserver on your PC)

DEBUG=1
SECRET_KEY=change-me-for-local-only
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
