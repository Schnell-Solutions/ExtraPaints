# Copy to .env inside /opt/extrapaints-staging on the server.
# Staging runs on port 8080 — does NOT touch live production on 80/443.

DEBUG=0
SECRET_KEY=generate-a-long-random-secret-different-from-production
ALLOWED_HOSTS=YOUR_SERVER_IP,staging.extrapaints.co.ke,localhost
CSRF_TRUSTED_ORIGINS=http://YOUR_SERVER_IP:8080,http://staging.extrapaints.co.ke:8080

POSTGRES_DB=extrapaints_staging
POSTGRES_USER=extrapaints_staging
POSTGRES_PASSWORD=change-me-strong-staging-password

USE_SECURE_PROXY=1
SECURE_SSL_REDIRECT=0

# Use http until staging has its own TLS subdomain
PUBLIC_SITE_URL=http://YOUR_SERVER_IP:8080

TAILWIND_CDN=0
STATIC_VERSION=1
LOG_LEVEL=INFO
GUNICORN_WORKERS=2

EMAIL_HOST=mail.yourprovider.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@extrapaints.co.ke
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=ExtraPaints Staging <noreply@extrapaints.co.ke>
SALES_TEAM_EMAIL=sales@extrapaints.co.ke
ADMIN_EMAIL=your@email.com
